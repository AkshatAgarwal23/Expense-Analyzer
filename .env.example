DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_analyzer

# Sarvam Speech-to-Text — never commit the real key
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
# translit = romanized Hinglish (works with expense regex). Use codemix for mixed scripts.
SARVAM_MODE=translit
SARVAM_LANGUAGE_CODE=unknown

OLLAMA_BASE_URL=http://127.0.0.1:11434
# After fine-tune: kharcha-extract (see notebooks/finetune_kharcha_extract.ipynb).
# Local without GPU: python -m scripts.build_kharcha_modelfile
#   then: ollama create kharcha-extract -f data/extraction/Modelfile.fewshot
# Fallback: llama3.2:3b
OLLAMA_MODEL=kharcha-extract
EXTRACTION_SKIP_LLM_WHEN_AMOUNT_FOUND=true
